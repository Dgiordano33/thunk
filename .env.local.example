# Optional: if unset, the Claude Code subprocess uses your local `claude` login.
ANTHROPIC_API_KEY=
# Optional: any Postgres, e.g. Supabase's Session pooler string. Without it, Thunk uses an
# embedded database in ~/.thunk/db. See README, Database.
DATABASE_URL=
DEFAULT_MODEL=claude-opus-5-5
# Optional remote access over Tailscale Serve (see docs/remote.md). Both are required to enable it.
# Comma-separated tailnet names, e.g. your-mac.tail1234.ts.net
THUNK_TRUSTED_HOSTS=
# Tailscale login allowed in, e.g. you@example.com
THUNK_TRUSTED_USER=
