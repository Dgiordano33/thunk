{
  "name": "nextjs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 127.0.0.1",
    "build": "next build",
    "start": "next start -H 127.0.0.1",
    "lint": "eslint",
    "postinstall": "node scripts/prepare-pty.mjs",
    "test:lifecycle": "node --conditions=react-server --test tests/lifecycle.test.cjs",
    "typecheck": "tsc --noEmit",
    "test:tasks": "node --conditions=react-server --test tests/tasks.test.cjs tests/task-tools.test.cjs && node --test components/tasks/ui.test.cjs",
    "test:notes": "node --conditions=react-server --test tests/notes.test.cjs tests/repo-notebooks.test.cjs tests/note-views.test.cjs",
    "test:routines": "node --conditions=react-server --test tests/routines.test.cjs",
    "test:vault": "node --conditions=react-server --test tests/vault.test.cjs",
    "test:multi-repo": "node --conditions=react-server --test tests/multi-repo.test.cjs",
    "test": "npm run test:lib && node --conditions=react-server --test tests/*.test.cjs && node --test components/tasks/ui.test.cjs components/inbox/ui.test.cjs",
    "test:lib": "node --test lib/*.test.mjs lib/*/*.test.mjs",
    "test:notifications": "node --conditions=react-server --test tests/notifications.test.cjs && node --test components/inbox/ui.test.cjs",
    "desktop:prepare": "npm run build && node scripts/prepare-desktop.mjs",
    "desktop:dev": "npm run desktop:prepare && electron desktop",
    "desktop:pack": "npm run desktop:prepare && electron-builder --config desktop/builder.cjs --mac --dir",
    "test:desktop": "node --test desktop/*.test.cjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.319",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.15",
    "@radix-ui/react-use-controllable-state": "^1.3.0",
    "@streamdown/cjk": "^1.0.4",
    "@streamdown/code": "^2.0.0",
    "@streamdown/math": "^1.0.3",
    "@streamdown/mermaid": "^1.0.3",
    "@supabase/supabase-js": "^2.119.0",
    "@tiptap/core": "^3.33.0",
    "@tiptap/extension-placeholder": "^3.33.0",
    "@tiptap/extension-table": "^3.33.0",
    "@tiptap/markdown": "^3.33.0",
    "@tiptap/pm": "^3.33.0",
    "@tiptap/react": "^3.33.0",
    "@tiptap/starter-kit": "^3.33.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "ai": "^7.0.164",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.2",
    "codemirror": "^6.0.2",
    "croner": "^11.0.0",
    "diff": "^9.0.0",
    "lucide-react": "^1.70.0",
    "motion": "^14.10.1",
    "nanoid": "^6.0.2",
    "next": "16.2.4",
    "node-pty": "1.1.0",
    "radix-ui": "^1.8.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-resizable-panels": "^4.19.1",
    "retune": "^0.7.6",
    "server-only": "^0.0.1",
    "shadcn": "^4.23.0",
    "shiki": "^4.6.0",
    "streamdown": "^2.7.1",
    "tw-animate-css": "^1.4.0",
    "use-stick-to-bottom": "^1.1.6",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "allowScripts": {
    "node-pty@1.1.0": true
  }
}
